// nextflow.config

docker.enabled = true

profiles {

    synthetic {
        params {
            samplesheet = 'testdata/samples.csv'
            reference   = 'testdata/ref.fasta'
            gff         = 'testdata/genes.gff3.gz'
            outdir      = 'results'
        }
    }

    sarscov2 {
        params {
            samplesheet = 'testdata_sarscov2/samples.csv'
            reference   = 'testdata_sarscov2/sars_cov2.fasta'
            gff         = 'testdata_sarscov2/sars_cov2.gff3.gz'
            outdir      = 'results_sars_cov2'
        }
    }
}